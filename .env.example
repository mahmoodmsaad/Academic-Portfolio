# Matrix Optimizer API Configuration
# After deploying the AWS Lambda function, add your API endpoint here
# Then copy this file to .env and fill in the actual endpoint URL

# Example: REACT_APP_MATRIX_API=https://abc123.execute-api.us-east-1.amazonaws.com/optimize
REACT_APP_MATRIX_API=

# Surface-target API endpoint used by Matrix Optimizer (ASE/default backend)
# Leave empty to disable API usage and force analytical JS fallback.
VITE_SURFACE_API=

# Optional dedicated endpoint for Pymatgen requests.
# When set, selecting "Pymatgen" in UI uses this endpoint instead of VITE_SURFACE_API.
VITE_SURFACE_API_PYMATGEN=
